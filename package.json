{
  "name": "janah-alriyadah-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "شركة جناح الريادة — Saudi electrical products e-commerce platform (storefront, REST API, admin dashboard)",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
