rules_version = '2';
// Janah Al Riyadah — Firestore security rules
// Paste in: Firebase console > Firestore Database > Rules > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner account(s) — must match ownerEmails in config.js
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['akrambajwa062@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Store settings (payment details, checkout form, categories): public read, owner write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Products: everyone can browse, only owner can change
    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Customer profiles
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isOwner();
    }

    // Orders
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stockDeducted == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total > 0;
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isOwner()
        // customer may add payment result (e.g. after card payment) ...
        || (signedIn() && resource.data.uid == request.auth.uid
            && onlyChanges(['payment', 'updatedAt'])
            && request.resource.data.payment.method == resource.data.payment.method)
        // ... or cancel while still pending
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'
            && onlyChanges(['status', 'history', 'updatedAt']));
      allow delete: if isOwner();
    }

    // Repair / service requests
    match /services/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isOwner();
    }
  }
}
