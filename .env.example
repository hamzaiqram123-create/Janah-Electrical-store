# ─────────────────────────────────────────────────────────────────────────────
# شركة جناح الريادة — environment configuration
# Copy to .env and fill in. Never commit .env. Every variable is validated at
# start-up (src/server/config.ts); the server refuses to start on a bad value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public address of the site, no trailing slash. Used for links in e-mails, the
# sitemap, canonical URLs, payment return URLs and the CSRF origin check.
APP_URL=https://www.example.sa
# PostgreSQL 14+ (16 recommended). The pg_trgm extension is created by the migration.
DATABASE_URL=postgres://janah:CHANGE_ME@localhost:5432/janah
# Only read by docker-compose.yml: password of the bundled PostgreSQL container
# (compose builds DATABASE_URL from it, overriding the line above).
POSTGRES_PASSWORD=CHANGE_ME
DB_POOL_MAX=10
# Customer / staff session lifetime in days.
SESSION_DAYS=30
# Set to true ONLY when the app sits behind your own reverse proxy (nginx, Caddy,
# a load balancer) that sets X-Forwarded-For. Needed for correct rate limiting.
TRUST_PROXY=true
# Optional: a header your proxy sets to the real visitor address (cf-connecting-ip, true-client-ip …).
CLIENT_IP_HEADER=
LOG_LEVEL=info
# In-process scheduler (notification queue, unpaid-order expiry, abandoned-cart
# e-mails, ZATCA queue, clean-up). With several app instances set this to false
# on all but one.
RUN_JOBS=true

# ── First administrator (read by `bun run seed` only) ────────────────────────
# Remove these two lines after the first seed. You can also run:
#   bun run admin:create owner@example.sa 'a-strong-password'
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to false to seed without the sample catalogue (57 demo products, 8 brands).
SEED_SAMPLE_CATALOG=true
# Docker image only: run the seed on container start. Set true for the very first start, then false.
SEED_ON_START=false

# ── Product images and videos ────────────────────────────────────────────────
# local: files under UPLOAD_DIR (put it on a persistent volume and back it up)
# s3:    any S3-compatible bucket (AWS, Cloudflare R2, MinIO, STC Cloud …)
# db:    stored in PostgreSQL — for hosts that wipe the disk on restart (Render, Railway…);
#        simplest option, included in database backups; fine for a few thousand product photos
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket or its CDN, e.g. https://cdn.example.sa
S3_PUBLIC_URL=

# ── Online payments (mada, Visa, Mastercard, Apple Pay, STC Pay) ─────────────
# none:    only cash on delivery is offered at checkout
# moyasar: hosted payment page by Moyasar (https://moyasar.com). Card details are
#          entered on Moyasar's page and never reach this server.
PAYMENT_PROVIDER=none
# Secret API key from the Moyasar dashboard (sk_test_… / sk_live_…).
MOYASAR_SECRET_KEY=
# Leave as is unless Moyasar tells you otherwise.
MOYASAR_API_BASE=https://api.moyasar.com/v1
# In the Moyasar dashboard add a webhook pointing to: ${APP_URL}/api/webhooks/moyasar

# ── E-mail ───────────────────────────────────────────────────────────────────
# log:    nothing is sent; messages are stored in the notifications table as "skipped"
# resend: send through https://resend.com (verify your sending domain there first)
EMAIL_PROVIDER=log
EMAIL_FROM="شركة جناح الريادة <no-reply@example.sa>"
RESEND_API_KEY=

# ── SMS ──────────────────────────────────────────────────────────────────────
# none | unifonic (https://www.unifonic.com — needs a sender ID registered with CITC)
SMS_PROVIDER=none
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# ── WhatsApp Business ────────────────────────────────────────────────────────
# none | meta (WhatsApp Cloud API). Business-initiated messages need templates
# approved by Meta; see docs/DEPLOYMENT.md.
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Installed app in Google Play (optional, see docs/APPS.md) ──────────────
# Package ID chosen in PWABuilder and the SHA-256 signing fingerprint(s) from Play Console → App integrity.
# Enables /.well-known/assetlinks.json so the Play app opens the site without a browser bar.
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256=

# ── ZATCA e-invoicing (Fatoora) ──────────────────────────────────────────────
# disabled:   invoices are generated with the phase-1 QR code and stored; nothing is sent to ZATCA
# sandbox | simulation | production: phase-2 integration. Read docs/ZATCA.md before enabling:
# the cryptographic stamp (signer) must be supplied and validated with ZATCA's SDK first.
ZATCA_ENV=disabled
# Optional override of the Fatoora API base URL (defaults follow ZATCA_ENV).
ZATCA_API_BASE=
# Production CSID (binary security token) and secret returned by ZATCA onboarding.
ZATCA_CSID=
ZATCA_SECRET=
# EC secp256k1 private key, PEM, then base64-encoded on one line.
ZATCA_PRIVATE_KEY=
# X.509 certificate issued with the CSID (base64, as returned by ZATCA).
ZATCA_CERTIFICATE=
